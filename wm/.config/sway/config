set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu wmenu-run
set $browser firefox

font pango:JetBrainsMono Nerd Font Mono Bold 10
# I set it in zprofile, which is sourced by sddm before this
output * bg $WALLPAPER fill

exec dunst
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK

input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}
input type:keyboard { xkb_layout "eu" }

for_window [app_id="btop-floating"] floating enable, resize set 1200 800
workspace_auto_back_and_forth yes 

bar {
    position bottom
    status_command i3blocks
    tray_output none
    colors {
        statusline #ffffff
        background #0a0a0a
        inactive_workspace #323232 #323232 #5c5c5c
    }
}

default_border normal 0
default_floating_border normal 2

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
